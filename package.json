{
  "name": "sridevi-residency",
  "version": "1.0.0",
  "description": "Sridevi Residency — Lodge/Hotel Management System",
  "main": "index.js",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm start",
    "client": "cd client && npm run dev",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "keywords": ["hotel", "lodge", "management", "residency"],
  "author": "Sridevi Residency",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
