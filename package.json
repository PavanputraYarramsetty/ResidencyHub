{
  "name": "sridevi-residency",
  "version": "1.0.0",
  "description": "Sridevi Residency — Lodge/Hotel Management System",
  "main": "index.js",
  "scripts": {
    "build": "npm install && npm install --prefix server && npm install --prefix client --include=dev && npm run build --prefix client",
    "start": "node server/src/server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm start",
    "client": "cd client && npm run dev"
  },
  "keywords": ["hotel", "lodge", "management", "residency"],
  "author": "Sridevi Residency",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
